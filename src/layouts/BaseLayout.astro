---
import "../styles/global.css";
import AccessibilityBar from "../components/AccessibilityBar.astro";
const { title = "우리 헌법 기본권" } = Astro.props;
const base = import.meta.env.BASE_URL;
const hasSidebar = Astro.slots.has("sidebar");
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="naver-site-verification" content="ffc2b24a13c5c1c344b530b571c064a242a7693f" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css" />
  </head>
  <body>
    <a href="#main" class="skip-link">본문 바로가기</a>
    <header class="site-header no-print">
      <div class="header-inner">
        <a class="brand" href={base}>기본권<small>대한민국 헌법으로 배우는 기본권</small></a>
        <input type="checkbox" id="nav-toggle" class="nav-toggle sr-only" />
        <label for="nav-toggle" class="nav-burger no-print">☰ 메뉴</label>
        <nav class="tabs" aria-label="주요 메뉴">
        <a href={`${base}intro`}>기본권이란?</a>
        <a href={`${base}rights`}>기본권 목록</a>
        <a href={`${base}topics`}>주제 특집</a>
        <details class="nav-drop">
          <summary>수업하기 ▾</summary>
          <div class="nav-drop-panel">
            <a href={`${base}lessons`}>🧑‍🏫 수업하기</a>
            <a href={`${base}quiz`}>🎲 놀이·퀴즈</a>
            <a href={`${base}comics`}>🎨 만화</a>
            <a href={`${base}films`}>🎬 영화</a>
          </div>
        </details>
        <details class="nav-drop">
          <summary>교사 자료 ▾</summary>
          <div class="nav-drop-panel">
            <a href={`${base}teachers`}>📂 교사 자료</a>
            <a href={`${base}issues`}>💬 쟁점</a>
          </div>
        </details>
        <a href={`${base}glossary`}>용어사전</a>
        <a href={`${base}about`}>소개</a>
        </nav>
        <div class="header-right">
          <a class="header-search" href={`${base}search`}>🔍 검색</a>
          <AccessibilityBar />
        </div>
      </div>
    </header>
    <div class={`page ${hasSidebar ? "" : "no-sidebar"}`}>
      {hasSidebar && <slot name="sidebar" />}
      <main id="main"><slot /></main>
    </div>
    <footer class="no-print">
      <div class="footer-inner">
        본 설명은 학습용 요약이며 법적 효력이 있는 해석이 아닙니다. 정확한 내용은 헌법 원문과 공식 자료를 확인하세요.<br>
        콘텐츠 이용: <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/deed.ko" target="_blank" rel="noopener">CC BY-NC-SA 4.0</a> ·
        <a href={`${base}about`}>소개</a> ·
        <a href="https://github.com/15678910/fundamentalrights/issues" target="_blank" rel="noopener">오류 제보</a> ·
        <a href="mailto:fundamentalrights2026@gmail.com">fundamentalrights2026@gmail.com</a>
      </div>
    </footer>
    <div class="scroll-btns no-print">
      <button onclick="window.scrollTo({top:0,behavior:'smooth'})" aria-label="맨 위로" title="맨 위로">↑</button>
      <button onclick="window.scrollTo({top:document.documentElement.scrollHeight,behavior:'smooth'})" aria-label="맨 아래로" title="맨 아래로">↓</button>
    </div>
    <script is:inline>
      (function () {
        var drops = Array.prototype.slice.call(document.querySelectorAll(".nav-drop"));
        drops.forEach(function (d) {
          d.addEventListener("toggle", function () {
            if (d.open) drops.forEach(function (o) { if (o !== d) o.open = false; });
          });
        });
        document.addEventListener("click", function (e) {
          drops.forEach(function (d) { if (d.open && !d.contains(e.target)) d.open = false; });
        });
        if (window.matchMedia("(hover: hover)").matches) {
          drops.forEach(function (d) {
            var timer = null;
            d.addEventListener("mouseenter", function () {
              clearTimeout(timer);
              drops.forEach(function (o) { if (o !== d) o.open = false; });
              d.open = true;
            });
            d.addEventListener("mouseleave", function () {
              timer = setTimeout(function () { d.open = false; }, 200);
            });
            d.querySelector("summary").addEventListener("click", function (e) {
              if (d.open) e.preventDefault();
            });
          });
        }
      })();
    </script>
    <script src={`${base}scripts/a11y.js`} is:inline></script>
  </body>
</html>
