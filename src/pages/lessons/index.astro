---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import TeachersSidebar from "../../components/TeachersSidebar.astro";
const lessons = (await getCollection("lessons")).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="수업하기 | 기본권">
  <TeachersSidebar slot="sidebar" current="lessons" />
  <h1>수업하기</h1>
  <p style="color:var(--muted)">화면에 띄워 놓고 <b>단계를 하나씩 넘기며 그대로 진행하는</b> 수업 페이지입니다. 학생들이 스스로 아이디어를 내도록 발문과 활동이 이어집니다. 준비물은 대부분 종이와 칠판뿐이에요.</p>

  <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:.8rem;margin-top:1.2rem">
    {lessons.map((l) => (
      <a href={`${base}lessons/${l.id}`} style="border:1px solid var(--border);border-radius:12px;padding:1.1rem;text-decoration:none;color:var(--fg);display:flex;flex-direction:column;gap:.45rem">
        <span style="font-size:1.7rem">{l.data.icon}</span>
        <strong style="font-size:1.15rem">{l.data.title}</strong>
        <span style="color:var(--fg);font-size:.95rem;flex:1">{l.data.summary}</span>
        <div style="display:flex;flex-wrap:wrap;gap:.35rem;margin-top:.2rem">
          <span style="font-size:.8rem;background:var(--accent);color:#fff;border-radius:999px;padding:.15rem .6rem;font-weight:700">⏱ {l.data.periods}</span>
          <span style="font-size:.8rem;background:var(--card);border:1px solid var(--border);border-radius:999px;padding:.15rem .6rem">{l.data.level}</span>
        </div>
      </a>
    ))}
  </div>

  <section style="margin-top:2.2rem">
    <h2 style="font-size:1.25rem">주제별 권장 시수 한눈에 보기</h2>
    <div style="overflow-x:auto">
      <table style="border-collapse:collapse;width:100%;margin-top:.6rem">
        <thead>
          <tr style="background:var(--card)">
            <th style="border:1px solid var(--border);padding:.5rem .7rem;text-align:left">수업</th>
            <th style="border:1px solid var(--border);padding:.5rem .7rem;text-align:left">권장 시수</th>
            <th style="border:1px solid var(--border);padding:.5rem .7rem;text-align:left">대상</th>
            <th style="border:1px solid var(--border);padding:.5rem .7rem;text-align:left">관련 조항</th>
          </tr>
        </thead>
        <tbody>
          {lessons.map((l) => (
            <tr>
              <td style="border:1px solid var(--border);padding:.5rem .7rem"><a href={`${base}lessons/${l.id}`}>{l.data.title}</a></td>
              <td style="border:1px solid var(--border);padding:.5rem .7rem;white-space:nowrap">{l.data.periods}</td>
              <td style="border:1px solid var(--border);padding:.5rem .7rem">{l.data.level}</td>
              <td style="border:1px solid var(--border);padding:.5rem .7rem">{l.data.relatedRights.map((n: number) => `제${n}조`).join(" · ")}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p style="color:var(--muted);font-size:.9rem;margin-top:.6rem">14개 수업을 모두 진행하면 총 27차시 분량입니다. 수업 준비 자료(수업안·워크시트·평가지)는 <a href={`${base}teachers`}>교사 자료</a>에 있습니다. 수업을 마친 뒤에는 <a href={`${base}check`}>스스로 점검</a>에서 학생들이 즉시 피드백을 받으며 배운 것을 확인할 수 있어요.</p>
  </section>
</BaseLayout>
