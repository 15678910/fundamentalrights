---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
const docs = (await getCollection("sdgs")).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="SDGs 자료집 | 지속가능발전과 기본권">
  <h1>지속가능발전(SDGs) 자료집</h1>
  <p style="color:var(--muted);max-width:44rem">미래 세대의 몫을 지키는 발전 — 유엔의 17개 목표를 개념부터 민주주의·교육까지, 네 권의 자료로 깊이 있게 다룹니다. 독일 바덴뷔르템베르크주 정치교육원(lpb)의 지속가능성 특집을 우리 헌법과 한국 현실에 맞게 재구성했습니다.</p>

  <img src={`${base}illustrations/sdg/new_ksdgs_symbols.png`} alt="국가 지속가능발전목표(K-SDGs) 17개 목표를 한눈에 정리한 공식 그림" style="width:100%;border-radius:12px;border:1px solid var(--border);margin:1rem 0" />
  <p style="color:var(--muted);font-size:.85rem;margin-top:0">이미지: 국가 지속가능발전목표(K-SDGs) 공식 자료 — <a href="https://www.ncsd.go.kr/" target="_blank" rel="noopener">지속가능발전포털</a></p>

  <h2 style="font-size:1.35rem;margin-top:1.6rem">자료집 목차</h2>
  <div style="display:grid;gap:.8rem;margin-top:.8rem">
    {docs.map((d, i) => (
      <a href={`${base}sdgs/${d.id}`} style="border:1px solid var(--border);border-radius:12px;padding:1.1rem 1.3rem;text-decoration:none;color:var(--fg);display:flex;gap:1rem;align-items:flex-start;background:var(--card)">
        <span style="font-size:2rem;flex:none">{d.data.icon}</span>
        <span>
          <strong style="font-size:1.18rem;display:block">{i + 1}권 · {d.data.title}</strong>
          <span style="color:var(--muted);font-size:.95rem">{d.data.summary}</span>
        </span>
      </a>
    ))}
  </div>

  <p style="color:var(--muted);font-size:.9rem;margin-top:1.4rem">
    함께 보기: <a href={`${base}topics/10-지속가능발전과-기본권`}>주제 특집 — 지속가능발전과 기본권(개관)</a> ·
    <a href={`${base}issues/기후보호와-사회변화`}>쟁점 — 기후 보호와 사회 변화</a> ·
    <a href={`${base}rights/35-환경권`}>제35조 환경권</a>
  </p>
</BaseLayout>
