---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
const docs = (await getCollection("sdgs")).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="SDGs 자료집 | 지속가능발전과 기본권">
  <h1>지속가능발전(SDGs) 자료집</h1>
  <p style="color:var(--muted);max-width:44rem">미래 세대의 몫을 지키는 발전 — 유엔의 17개 목표를 개념부터 민주주의·교육까지, 네 권의 자료로 깊이 있게 다룹니다. 독일 바덴뷔르템베르크주 정치교육원(lpb)의 지속가능성 특집을 우리 헌법과 한국 현실에 맞게 재구성했습니다.</p>

  <div style="background:#ffffff;border:1px solid var(--border);border-radius:12px;padding:1.3rem;margin:1rem 0 0">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;margin-bottom:1rem">
      <div>
        <p style="margin:0;font-size:1.75rem;font-weight:800;color:#3fa1d8;letter-spacing:-.02em">국가 지속가능발전목표</p>
        <p style="margin:.15rem 0 0;font-size:.95rem;font-weight:700;color:#555555">KOREAN SUSTAINABLE DEVELOPMENT GOALS (K-SDGs)</p>
      </div>
      <img src={`${base}illustrations/sdg/k_sdgs_logo.svg`} alt="" style="height:64px" />
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(96px,1fr));gap:6px">
      {["빈곤퇴치","기아종식","건강과 웰빙","양질의 교육","성평등","깨끗한 물과 위생","적정 가격의 깨끗한 에너지","양질의 일자리와 경제성장","산업, 혁신, 사회기반 시설","불평등 감소","지속가능한 도시와 지역사회","책임 있는 소비와 생산","기후 행동","수생태계 보전","육상생태계 보전","평화, 정의, 강력한 제도","목표 달성을 위한 파트너십"].map((name, i) => (
        <a class="sdg-tile" href={`${base}sdgs/02-17가지-목표#목표-${i + 1}-${name.replace(/,/g, "").replace(/ /g, "-")}`} title={`목표 ${i + 1} ${name} — 자세히 보기`}>
          <img src={`${base}illustrations/sdg/k_sdgs${String(i + 1).padStart(2, "0")}.svg`} alt={`목표 ${i + 1} ${name}`} style="width:100%" />
        </a>
      ))}
      <a class="sdg-tile" href={`${base}sdgs/02-17가지-목표`} title="17가지 목표 하나씩 — 자료집 2권">
        <img src={`${base}illustrations/sdg/k_sdgs_logo.svg`} alt="국가지속가능발전목표 K-SDGs" style="width:100%" />
      </a>
    </div>
  </div>
  <style>
    .sdg-tile { display: block; transition: transform .18s ease; }
    .sdg-tile:hover { transform: scale(1.08); position: relative; z-index: 2; }
    .sdg-tile img { display: block; }
  </style>
  <p style="color:var(--muted);font-size:.85rem;margin-top:.4rem">이미지: <a href="https://www.ncsd.go.kr/" target="_blank" rel="noopener">지속가능발전포털</a> 공식 심볼(출처 표시·비상업·변경 없음)</p>

  <h2 style="font-size:1.35rem;margin-top:1.6rem">자료집 목차</h2>
  <div style="display:grid;gap:.8rem;margin-top:.8rem">
    {docs.map((d, i) => (
      <a href={`${base}sdgs/${d.id}`} style="border:1px solid var(--border);border-radius:12px;padding:1.1rem 1.3rem;text-decoration:none;color:var(--fg);display:flex;gap:1rem;align-items:flex-start;background:var(--card)">
        <span style="font-size:2rem;flex:none">{d.data.icon}</span>
        <span>
          <strong style="font-size:1.18rem;display:block">{i + 1}권 · {d.data.title}</strong>
          <span style="color:var(--muted);font-size:.95rem">{d.data.summary}</span>
        </span>
      </a>
    ))}
  </div>

  <p style="color:var(--muted);font-size:.9rem;margin-top:1.4rem">
    함께 보기: <a href={`${base}topics/10-지속가능발전과-기본권`}>주제 특집 — 지속가능발전과 기본권(개관)</a> ·
    <a href={`${base}issues/기후보호와-사회변화`}>쟁점 — 기후 보호와 사회 변화</a> ·
    <a href={`${base}rights/35-환경권`}>제35조 환경권</a>
  </p>
</BaseLayout>
