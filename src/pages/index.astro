---
import BaseLayout from "../layouts/BaseLayout.astro";
import MascotScene from "../components/MascotScene.astro";
const base = import.meta.env.BASE_URL;

const features = [
  {
    img: "landing-about",
    title: "우리 사이트 소개",
    desc: "독일 정치교육에서 영감을 받아, 헌법 제2장의 기본권을 쉬운 말·보통·자세히 세 단계로 풀어냅니다. 편집 원칙과 이용 방법을 알아보세요.",
    href: `${base}about`,
    cta: "소개 보기",
  },
  {
    img: "landing-teacher",
    title: "교권 침해, 함께 풀기",
    desc: "학생인권과 교권은 부딪히는 걸까요? 교권 침해와 학부모 갑질, 그리고 서로의 존엄을 지키는 교실을 헌법의 눈으로 살펴봅니다.",
    href: `${base}issues/교권침해-학부모갑질`,
    cta: "쟁점 읽기",
  },
  {
    img: "landing-law",
    title: "법률 제·개정 제안",
    desc: "기본권 교육을 모두에게 — 「기본권교육지원법」 시민 법률안 초안과 정책 제언을 읽고, 법이 만들어지는 과정을 함께 생각해 봅니다.",
    href: `${base}bill`,
    cta: "법률안 보기",
  },
];

const sections = [
  { icon: "📜", label: "기본권 목록", desc: "제10조~제39조", href: `${base}rights` },
  { icon: "🔎", label: "주제 특집", desc: "민주주의·AI·보이텔스바흐", href: `${base}topics` },
  { icon: "🧑‍🏫", label: "수업하기", desc: "단계별 진행 수업 14편 (27차시)", href: `${base}lessons` },
  { icon: "🎲", label: "놀이·퀴즈", desc: "90문항 3단계", href: `${base}quiz` },
  { icon: "🎨", label: "만화", desc: "네 컷 만화 33편", href: `${base}comics` },
  { icon: "🎬", label: "영화", desc: "영화로 배우는 기본권", href: `${base}films` },
  { icon: "📂", label: "교사 자료", desc: "수업안·워크시트 92종", href: `${base}teachers` },
  { icon: "💬", label: "쟁점", desc: "22가지 현실 논쟁", href: `${base}issues` },
  { icon: "📖", label: "용어사전", desc: "23개 용어 + 짝맞추기", href: `${base}glossary` },
];
---
<BaseLayout title="기본권 학습터 — 대한민국 헌법으로 배우는 기본권">
  <section style="text-align:center;padding:.5rem 0 0">
    <MascotScene />
    <h1 style="margin:.6rem 0 .4rem;font-size:2rem">우리 헌법이 지켜주는 권리</h1>
    <p style="color:var(--muted);max-width:34rem;margin:0 auto;font-size:1.05rem">
      대한민국 헌법 제2장의 기본권을 <b>쉬운 말 · 보통 · 자세히</b> 세 단계로 —
      초등학생부터 누구나 자기 수준에서 읽을 수 있어요.
    </p>
  </section>

  <section class="slider" aria-roledescription="carousel" aria-label="주요 소식" style="margin-top:2rem">
    <div class="slider-track" id="slider-track">
      {features.map((f) => (
        <a class="slide" href={f.href}>
          <img src={`${base}illustrations/${f.img}.svg`} alt="" />
          <div class="slide-caption">
            <strong>{f.title}</strong>
            <span>{f.desc}</span>
            <em>{f.cta} →</em>
          </div>
        </a>
      ))}
    </div>
    <div class="slider-controls">
      {features.map((f, i) => (
        <button class="slider-dot" data-slide={i} aria-label={`${i + 1}번째: ${f.title}`}></button>
      ))}
      <button class="slider-pause" id="slider-pause" aria-label="자동 넘김 일시정지">⏸</button>
    </div>
  </section>

  <style>
    .slider { position: relative; border-radius: 14px; overflow: hidden; border: 1px solid var(--border); }
    .slider-track { display: flex; transition: transform .6s ease; }
    .slide { flex: 0 0 100%; position: relative; display: block; text-decoration: none; color: var(--fg); }
    .slide img { width: 100%; display: block; aspect-ratio: 600 / 260; object-fit: cover; }
    .slide-caption {
      position: absolute; left: 1.2rem; bottom: 1.1rem; max-width: 62%;
      background: var(--bg); border-radius: 10px; padding: .85rem 1.1rem;
      box-shadow: 0 3px 14px rgba(0,0,0,.18);
      display: flex; flex-direction: column; gap: .3rem;
    }
    .slide-caption strong { font-size: 1.25rem; }
    .slide-caption span { font-size: .92rem; line-height: 1.55; }
    .slide-caption em { font-style: normal; color: var(--accent); font-weight: 700; }
    .slider-controls {
      position: absolute; right: 1rem; bottom: 1rem;
      display: flex; align-items: center; gap: .5rem;
    }
    .slider-dot {
      width: 14px; height: 14px; border-radius: 50%; border: 2px solid var(--accent);
      background: var(--bg); cursor: pointer; padding: 0;
    }
    .slider-dot[aria-current="true"] { background: var(--accent); }
    .slider-pause {
      width: 30px; height: 30px; border-radius: 50%; border: none; cursor: pointer;
      background: var(--accent); color: #fff; font-size: .85rem; line-height: 1;
    }
    @media (max-width: 640px) {
      .slide-caption { position: static; max-width: none; border-radius: 0; box-shadow: none; border-top: 1px solid var(--border); }
      .slider-controls { position: static; justify-content: center; padding: .6rem 0 .8rem; background: var(--bg); }
      .slide-caption strong { font-size: 1.1rem; }
    }
  </style>

  <script is:inline>
    (function () {
      var track = document.getElementById("slider-track");
      var dots = Array.prototype.slice.call(document.querySelectorAll(".slider-dot"));
      var pauseBtn = document.getElementById("slider-pause");
      var n = dots.length, cur = 0, timer = null, playing = true;

      function show(i) {
        cur = (i + n) % n;
        track.style.transform = "translateX(-" + cur * 100 + "%)";
        dots.forEach(function (d, k) { d.setAttribute("aria-current", k === cur ? "true" : "false"); });
      }
      function start() {
        stop();
        timer = setInterval(function () { show(cur + 1); }, 6000);
        playing = true; pauseBtn.textContent = "⏸"; pauseBtn.setAttribute("aria-label", "자동 넘김 일시정지");
      }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }

      dots.forEach(function (d) {
        d.addEventListener("click", function () { show(parseInt(d.dataset.slide, 10)); if (playing) start(); });
      });
      pauseBtn.addEventListener("click", function () {
        if (playing) { stop(); playing = false; pauseBtn.textContent = "▶"; pauseBtn.setAttribute("aria-label", "자동 넘김 재생"); }
        else { show(cur + 1); start(); }
      });
      var slider = track.parentElement;
      slider.addEventListener("mouseenter", function () { if (playing) stop(); });
      slider.addEventListener("mouseleave", function () { if (playing) start(); });

      show(0); start();
    })();
  </script>

  <section style="margin-top:2.2rem">
    <h2 style="font-size:1.3rem;margin-bottom:.7rem">둘러보기</h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:.7rem">
      {sections.map((s) => (
        <a href={s.href} style="border:1px solid var(--border);border-radius:12px;padding:.9rem;text-decoration:none;color:var(--fg);display:flex;flex-direction:column;gap:.15rem;background:var(--card)">
          <span style="font-size:1.6rem">{s.icon}</span>
          <strong style="font-size:1.02rem">{s.label}</strong>
          <span style="color:var(--muted);font-size:.85rem">{s.desc}</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
