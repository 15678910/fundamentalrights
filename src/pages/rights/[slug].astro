---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import DifficultyToggle from "../../components/DifficultyToggle.astro";
import OriginalText from "../../components/OriginalText.astro";
import Quiz from "../../components/Quiz.astro";
import InfoSection from "../../components/InfoSection.astro";
import { getCategory } from "../../lib/categories";
import Sidebar from "../../components/Sidebar.astro";

export async function getStaticPaths() {
  const rights = await getCollection("rights");
  return rights.map((r) => ({ params: { slug: r.id }, props: { entry: r } }));
}

type Props = { entry: CollectionEntry<"rights"> };
const { entry } = Astro.props;
const { Content } = await render(entry);
const cat = getCategory(entry.data.category);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={`${entry.data.title} | 우리 헌법 기본권`}>
  <Sidebar slot="sidebar" currentId={entry.id} />
  <p style="color:var(--muted);font-size:.85rem">
    <a href={base}>홈</a> ›
    <span style={`color:${cat?.color}`}>{cat?.label}</span>
  </p>
  <h1 style="margin:.2rem 0">제{entry.data.article}조 · {entry.data.title}</h1>
  {entry.data.intro && <p style="font-size:1.05rem;color:var(--muted);margin:.3rem 0 0">{entry.data.intro}</p>}

  <DifficultyToggle />

  <article>
    <Content />
  </article>

  <OriginalText text={entry.data.original} article={entry.data.article} />

  {entry.data.cases && <InfoSection icon="🏠" title="실생활 이야기" text={entry.data.cases} />}
  {entry.data.protectors && <InfoSection icon="🛡️" title="누가 지켜주나요?" text={entry.data.protectors} />}
  {entry.data.history && <InfoSection icon="📜" title="어떻게 생겨났나요?" text={entry.data.history} />}
  {entry.data.questions.length > 0 && (
    <section style="margin:1.5rem 0">
      <h2 style="font-size:1.15rem">💭 생각해 볼 질문</h2>
      <ul style="margin:.4rem 0 0;padding-left:1.2rem;line-height:1.9">
        {entry.data.questions.map((q) => <li>{q}</li>)}
      </ul>
    </section>
  )}

  {entry.data.quiz.length > 0 && <Quiz questions={entry.data.quiz} />}

  <script src={`${base}scripts/difficulty-toggle.js`} is:inline></script>
  <script src={`${base}scripts/quiz-client.js`} is:inline></script>
</BaseLayout>
