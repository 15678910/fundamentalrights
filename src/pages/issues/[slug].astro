---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import SupportBox from "../../components/SupportBox.astro";
import Sidebar from "../../components/Sidebar.astro";
import Illustration from "../../components/Illustration.astro";

export async function getStaticPaths() {
  const issues = await getCollection("issues");
  return issues.map((i) => ({ params: { slug: i.id }, props: { entry: i } }));
}

type Props = { entry: CollectionEntry<"issues"> };
const { entry } = Astro.props;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL;
const rights = await getCollection("rights");
const related = entry.data.relatedRights
  .map((n: number) => rights.find((r) => r.data.article === n))
  .filter(Boolean);
---
<BaseLayout title={`${entry.data.title} | 쟁점으로 배우는 기본권`}>
  <Sidebar slot="sidebar" />
  <p style="color:var(--muted);font-size:.85rem"><a href={base}>홈</a> › <a href={`${base}issues`}>쟁점</a></p>
  <div style="display:flex;gap:1rem;align-items:center;margin:.2rem 0"><Illustration name={`issue-${entry.data.order}`} alt="" size={72} /><h1 style="margin:0">{entry.data.title}</h1></div>
  <p style="font-size:1.05rem;color:var(--muted);margin:.3rem 0 0">{entry.data.summary}</p>

  <article>
    <Content />
  </article>

  {related.length > 0 && (
    <section style="margin:1.5rem 0">
      <h2 style="font-size:1.15rem">🔗 관련 기본권</h2>
      <div style="display:flex;flex-wrap:wrap;gap:.5rem;margin-top:.4rem">
        {related.map((r: any) => (
          <a href={`${base}rights/${r.id}`} style="border:1px solid var(--border);border-radius:999px;padding:.3rem .8rem;text-decoration:none;color:var(--fg)">제{r.data.article}조 · {r.data.title}</a>
        ))}
      </div>
    </section>
  )}

  {entry.data.helplines.length > 0 && <SupportBox lines={entry.data.helplines} />}
</BaseLayout>
