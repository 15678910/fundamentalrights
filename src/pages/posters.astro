---
import BaseLayout from "../layouts/BaseLayout.astro";
import TeachersSidebar from "../components/TeachersSidebar.astro";
import MascotScene from "../components/MascotScene.astro";
import { CATEGORIES } from "../lib/categories";
const base = import.meta.env.BASE_URL;
const siteUrl = "fundamentalrights.kr";
const catRanges: Record<string, string> = {
  comprehensive: "제10조 · 제37조",
  equality: "제11조",
  freedom: "제12조 ~ 제23조",
  participation: "제24조 · 제25조",
  claim: "제26조 ~ 제30조",
  social: "제31조 ~ 제36조",
  duty: "제38조 · 제39조",
};
---
<BaseLayout title="교실 포스터 | 기본권">
  <TeachersSidebar slot="sidebar" current="posters" />
  <p style="color:var(--muted);font-size:.85rem" class="no-print"><a href={base}>홈</a> › <a href={`${base}teachers`}>교사 자료</a></p>
  <h1 class="no-print">교실 게시용 포스터 4종</h1>
  <p class="no-print" style="color:var(--muted)">🖨 <button onclick="window.print()" style="border:1px solid var(--border);border-radius:8px;background:var(--bg);color:var(--fg);cursor:pointer;padding:.4rem .9rem;font-weight:600">인쇄하기</button> — A4 세로 기준, 포스터마다 한 장씩 인쇄됩니다.</p>

  <section class="poster" style="border:3px solid var(--fg);border-radius:16px;padding:2.2rem 1.8rem;margin:1.5rem 0;text-align:center">
    <p style="letter-spacing:.2em;font-weight:700;color:var(--accent);margin:0">우리 교실의 세 가지 약속</p>
    <h2 style="font-size:1.9rem;margin:.4rem 0 1.4rem">논쟁적인 것은 논쟁적으로</h2>
    <div style="text-align:left;max-width:36rem;margin:0 auto;display:grid;gap:1rem">
      <div style="display:flex;align-items:center;gap:.9rem">
        <img src={`${base}illustrations/mascot-semo.svg`} alt="세모" style="width:46px;height:62px;flex:none" />
        <p style="margin:0;font-size:1.15rem"><b style="color:var(--accent)">하나.</b> 누구도 남에게 생각을 강요하지 않습니다.</p>
      </div>
      <div style="display:flex;align-items:center;gap:.9rem">
        <img src={`${base}illustrations/mascot-nemo.svg`} alt="네모" style="width:48px;height:50px;flex:none" />
        <p style="margin:0;font-size:1.15rem"><b style="color:var(--accent)">둘.</b> 여러 입장이 있는 문제는 여러 입장 그대로 다룹니다.</p>
      </div>
      <div style="display:flex;align-items:center;gap:.9rem">
        <img src={`${base}illustrations/mascot-donggeurami.svg`} alt="동그라미" style="width:50px;height:50px;flex:none" />
        <p style="margin:0;font-size:1.15rem"><b style="color:var(--accent)">셋.</b> 판단은 각자 스스로, 근거와 함께 내립니다.</p>
      </div>
    </div>
    <div style="display:flex;align-items:center;justify-content:center;gap:.8rem;margin-top:1.6rem">
      <a href="https://fundamentalrights.kr/" style="line-height:0"><img src={`${base}qr-site.svg`} alt="사이트 QR코드 — 클릭하면 홈으로" style="width:72px;height:72px" /></a>
      <p style="color:var(--muted);font-size:.85rem;margin:0;text-align:left">보이텔스바흐 합의(1976) · 기본권 배움터<br>{siteUrl}</p>
    </div>
  </section>

  <section class="poster" style="border:3px solid var(--fg);border-radius:16px;padding:2.2rem 1.8rem;margin:1.5rem 0;text-align:center">
    <h2 style="font-size:1.9rem;margin:.2rem 0 .4rem">헌법이 지켜주는 나의 권리</h2>
    <p style="color:var(--muted);margin:0 0 1.4rem">대한민국 헌법 제2장 · 제10조~제39조</p>
    <div style="text-align:left;max-width:30rem;margin:0 auto;display:grid;gap:.55rem">
      {CATEGORIES.map((c) => (
        <div style="display:flex;align-items:center;gap:.7rem">
          <span style={`width:14px;height:14px;border-radius:4px;background:${c.color};flex:none`}></span>
          <b style="min-width:7.5rem">{c.label}</b>
          <span style="color:var(--muted)">{catRanges[c.key]}</span>
        </div>
      ))}
    </div>
    <p style="font-size:1.05rem;margin:1.6rem 0 0"><b>기본권은 어른만의 것이 아닙니다 — 모두의 것입니다.</b></p>
    <div style="display:flex;align-items:center;justify-content:center;gap:.8rem;margin-top:1.2rem">
      <a href="https://fundamentalrights.kr/" style="line-height:0"><img src={`${base}qr-site.svg`} alt="사이트 QR코드 — 클릭하면 홈으로" style="width:72px;height:72px" /></a>
      <p style="color:var(--muted);font-size:.85rem;margin:0;text-align:left">더 알아보기 · 기본권 배움터<br>{siteUrl}</p>
    </div>
  </section>

  <section class="poster" style="border:3px solid var(--fg);border-radius:16px;padding:2.2rem 1.8rem;margin:1.5rem 0;text-align:center">
    <h2 style="font-size:1.9rem;margin:.2rem 0 1rem">권리에는 책임이 따릅니다</h2>
    <blockquote style="max-width:34rem;margin:0 auto;border-left:5px solid var(--accent);padding:.4rem 0 .4rem 1rem;text-align:left;font-size:1.05rem;line-height:1.9">
      국민의 모든 자유와 권리는 … 필요한 경우에 한하여 법률로써 제한할 수 있으며,
      제한하는 경우에도 자유와 권리의 <b>본질적인 내용을 침해할 수 없다</b>.
      <span style="display:block;color:var(--muted);font-size:.85rem;margin-top:.4rem">— 헌법 제37조 제2항</span>
    </blockquote>
    <div style="display:flex;align-items:center;justify-content:center;gap:1.2rem;margin-top:1.4rem">
      <img src={`${base}illustrations/mascot-semo.svg`} alt="세모" style="width:58px;height:78px;transform:rotate(-8deg)" />
      <p style="font-size:1.15rem;margin:0;line-height:1.9">
        내 권리가 소중한 만큼<br>
        <b>네 권리도 같은 무게로 소중합니다.</b>
      </p>
      <img src={`${base}illustrations/mascot-donggeurami.svg`} alt="동그라미" style="width:64px;height:64px;transform:rotate(8deg) scaleX(-1)" />
    </div>
    <div style="display:flex;align-items:center;justify-content:center;gap:.8rem;margin-top:1.2rem">
      <a href="https://fundamentalrights.kr/" style="line-height:0"><img src={`${base}qr-site.svg`} alt="사이트 QR코드 — 클릭하면 홈으로" style="width:72px;height:72px" /></a>
      <p style="color:var(--muted);font-size:.85rem;margin:0;text-align:left">더 알아보기 · 기본권 배움터<br>{siteUrl}</p>
      <img src={`${base}illustrations/mascot-nemo.svg`} alt="네모" style="width:44px;height:46px;transform:rotate(14deg);margin-left:.3rem" />
    </div>
  </section>

  <section class="poster" style="border:3px solid var(--fg);border-radius:16px;padding:1.6rem 1.8rem 2rem;margin:1.5rem 0;text-align:center">
    <div style="display:flex;justify-content:center"><MascotScene max={290} /></div>
    <p style="letter-spacing:.2em;font-weight:700;color:var(--accent);margin:.2rem 0 0">헌법이 지켜주는 나의 권리</p>
    <h2 style="font-size:2.1rem;margin:.4rem 0 .2rem">기본권 배움터</h2>
    <p style="color:var(--muted);margin:0 0 1.3rem">초등학생부터 어르신까지 · 무료 · 광고 없음 · 가입 없음</p>

    <div style="text-align:left;max-width:32rem;margin:0 auto;display:grid;gap:.7rem;font-size:1.05rem">
      <p style="margin:0">📜 <b>헌법 제10조~제39조</b> 전 조항을 쉬운 말 · 보통 · 자세히 <b>3단계</b>로</p>
      <p style="margin:0">🧑‍🏫 화면에 띄워 그대로 진행하는 <b>수업 9차시</b>와 <b>교사 자료 58종</b></p>
      <p style="margin:0">💬 학생인권·교권, 휴대폰, AI, 딥페이크 — <b>쟁점 15가지</b>를 양쪽 입장 그대로</p>
      <p style="margin:0">🎲 수준별 <b>퀴즈 90문항</b> · 네 컷 <b>만화 33편</b> · 용어 짝맞추기 게임</p>
    </div>

    <div style="display:flex;align-items:center;justify-content:center;gap:1.1rem;margin-top:1.5rem">
      <a href="https://fundamentalrights.kr/" style="line-height:0"><img src={`${base}qr-site.svg`} alt="사이트 QR코드 — 클릭하면 홈으로" style="width:96px;height:96px" /></a>
      <div style="text-align:left">
        <p style="margin:0;font-size:1.3rem;font-weight:800"><a href="https://fundamentalrights.kr/" style="color:var(--fg);text-decoration:none">{siteUrl}</a></p>
        <p style="margin:.2rem 0 0;color:var(--muted);font-size:.9rem">휴대폰 카메라로 QR을 비추면<br>바로 열립니다</p>
      </div>
    </div>

    <div style="border-top:2px dashed var(--border);margin-top:1.5rem;padding-top:1rem">
      <p style="margin:0;font-size:.95rem"><b>함께 만들 분을 초대합니다</b> — 헌법 연구자·법조인의 감수, 선생님의 수업 후기,
      시민의 오류 제보, 쟁점 주제 보완 등 모두 환영합니다.</p>
      <p style="margin:.3rem 0 0;color:var(--muted);font-size:.9rem">✉ fundamentalrights2026@gmail.com</p>
    </div>
  </section>

  <style>
    @media print {
      .poster { page-break-after: always; border-color: #000; }
      .poster:last-of-type { page-break-after: auto; }
    }
  </style>
</BaseLayout>
