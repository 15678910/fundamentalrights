---
import { getCollection } from "astro:content";
const { currentId } = Astro.props;
const all = (await getCollection("teachers")).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;
const typeMeta: Record<string, string> = {
  "활용안내": "📖 사이트 활용 안내",
  "수업안": "📋 수업안",
  "워크시트": "📝 워크시트",
  "토론가이드": "💬 토론가이드",
  "평가지": "✅ 형성평가지",
  "가정통신문": "✉️ 가정통신문",
};
const types = Object.keys(typeMeta).filter((t) => all.some((i) => i.data.type === t));
const short = (title: string) => title.replace(/^[^—]+—\s*/, "");
---
<nav class="sidebar" aria-label="교사 자료 목록">
  <p class="sidebar-title">교사 자료실</p>
  <div class="sidebar-group">
    <a href={`${base}teachers#bundles`}>🧭 주제별 꾸러미</a>
    <a href={`${base}posters`}>🖼️ 교실 포스터</a>
    <a href={`${base}cards`}>🃏 용어 카드게임</a>
  </div>
  {types.map((t) => (
    <div class="sidebar-group">
      <h3><a href={`${base}teachers#type-${t}`} style="color:inherit;text-decoration:none">{typeMeta[t]} ({all.filter((i) => i.data.type === t).length})</a></h3>
      {all.filter((i) => i.data.type === t).map((i) => (
        <a href={`${base}teachers/${i.id}`} aria-current={i.id === currentId ? "page" : undefined}>{short(i.data.title)}</a>
      ))}
    </div>
  ))}
</nav>
