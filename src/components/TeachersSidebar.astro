---
import { getCollection } from "astro:content";
const { currentType, current } = Astro.props;
const all = await getCollection("teachers");
const base = import.meta.env.BASE_URL;
const typeMeta: Record<string, string> = {
  "활용안내": "📖 사이트 활용 안내",
  "수업안": "📋 수업안",
  "워크시트": "📝 워크시트",
  "토론가이드": "💬 토론가이드",
  "가정통신문": "✉️ 가정통신문",
  "평가지": "✅ 형성평가지",
};
const types = Object.keys(typeMeta).filter((t) => all.some((i) => i.data.type === t));
---
<nav class="sidebar" aria-label="교사 자료실 목차">
  <p class="sidebar-title">자료실 목차</p>
  <div class="sidebar-group">
    <a href={`${base}teachers#bundles`}>🧭 주제별 꾸러미</a>
    {types.map((t) => (
      <a href={`${base}teachers#type-${t}`} aria-current={t === currentType ? "page" : undefined}>
        {typeMeta[t]} ({all.filter((i) => i.data.type === t).length})
      </a>
    ))}
  </div>
  <div class="sidebar-group">
    <h3>수업 진행</h3>
    <a href={`${base}lessons`} aria-current={current === "lessons" ? "page" : undefined}>🧑‍🏫 수업하기 (단계별 진행)</a>
  </div>
  <div class="sidebar-group">
    <h3>인쇄 자료</h3>
    <a href={`${base}posters`} aria-current={current === "posters" ? "page" : undefined}>🖼️ 교실 포스터</a>
    <a href={`${base}cards`} aria-current={current === "cards" ? "page" : undefined}>🃏 용어 카드게임</a>
  </div>
</nav>
