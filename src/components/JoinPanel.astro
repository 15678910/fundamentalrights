---
import { firebase, fields, avatars, appCheck, emailjs } from "../data/participants";
const labels = Object.fromEntries(fields.map((f) => [f.key, f.label]));
const config = JSON.stringify({ ...firebase, fields: fields.map((f) => f.key), labels, appCheck, emailjs });
const mailOn = Boolean(emailjs.serviceId && emailjs.templateId && emailjs.publicKey);
const guardOn = Boolean(appCheck.siteKey);
---
<section class="join" aria-labelledby="join-h" data-join={config}>
  <div class="join-head">
    <h3 id="join-h">참여 신청</h3>
    <p class="join-total" aria-live="polite">참여 현황을 불러오는 중입니다…</p>
  </div>
  <ul class="join-fields">
    {fields.map((f) => (
      <li data-field={f.key}>
        <span class="join-label">{f.label}</span>
        <span class="join-count"><b>-</b>명</span>
        <ul class="join-names" aria-label={`${f.label} 참여자`}></ul>
      </li>
    ))}
  </ul>

  <form class="join-form" novalidate>
    <div class="join-grid">
      <fieldset>
        <legend>1. 참여 분야</legend>
        {fields.map((f, i) => (
          <label class="join-choice"><input type="radio" name="field" value={f.key} checked={i === 0} /> {f.label}</label>
        ))}
      </fieldset>
      <div>
        <details class="join-pick">
          <summary>2. 나를 나타낼 그림: <span class="join-picked" aria-hidden="true">{avatars[0].icon}</span> <small>(눌러서 고르기)</small></summary>
          <div class="join-avatars">
            {avatars.map((a, i) => (
              <label class="join-avatar" title={a.name}>
                <input type="radio" name="avatar" value={a.icon} checked={i === 0} />
                <span aria-hidden="true">{a.icon}</span>
                <span class="sr-only">{a.name}</span>
              </label>
            ))}
          </div>
          <div class="join-photo">
            <label for="join-photo">또는 내가 그린 그림·사진 올리기 (선택)</label>
            <input id="join-photo" type="file" accept="image/*" />
            <label class="join-choice"><input type="checkbox" id="join-cartoon" checked /> 만화 느낌으로 바꾸기</label>
            <p class="join-photo-note">그림은 이 기기 안에서 작게 줄여지며, 공개에 동의하신 경우에만 그 작은 그림이 올라갑니다. 원본은 어디에도 보내지 않습니다.</p>
            <button type="button" class="join-photo-clear" hidden>올린 그림 지우기</button>
          </div>
        </details>
        <p class="join-row">
          <label for="join-nick">3. 닉네임 (12자까지)</label>
          <input id="join-nick" name="nickname" type="text" maxlength="12" autocomplete="off" />
        </p>
        <p class="join-row">
          <label for="join-contact">4. 연락처 (이메일·전화, 감수 연락용)</label>
          <input id="join-contact" name="contact" type="text" maxlength="100" autocomplete="email" />
        </p>
      </div>
    </div>
    <p class="join-hp" aria-hidden="true"><label>비워 두세요 <input name="website" type="text" tabindex="-1" autocomplete="off" /></label></p>
    <label class="join-choice"><input type="checkbox" name="consent" /> 닉네임과 그림을 이 페이지에 공개하는 데 동의합니다. (선택)</label>
    <label class="join-choice"><input type="checkbox" name="privacy" /> 연락처 수집·이용에 동의합니다. (필수 · 감수 연락 목적){mailOn && " 신청 알림은 메일 서비스(EmailJS)를 거쳐 운영자에게 전달됩니다."}</label>
    <div class="join-send">
      <button type="submit" class="join-btn">참여 신청하기</button>
      <span class="join-msg" role="status" aria-live="polite"></span>
    </div>
  </form>
  <p class="join-note">연락처는 운영자만 볼 수 있고 화면에 나오지 않습니다. 공개에 동의하지 않으면 인원 수에만 반영됩니다. 삭제·수정은 fundamentalrights2026@gmail.com 으로 알려 주세요.{guardOn && " 이 양식은 reCAPTCHA로 보호되며 Google의 개인정보처리방침과 서비스 약관이 적용됩니다."}</p>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-join]");
  if (root) {
    const cfg = JSON.parse(root.dataset.join || "{}") as {
      projectId: string; apiKey: string; fields: string[]; labels: Record<string, string>;
      appCheck: { appId: string; siteKey: string }; emailjs: { serviceId: string; templateId: string; publicKey: string };
    };
    const base = `https://firestore.googleapis.com/v1/projects/${cfg.projectId}/databases/(default)/documents`;
    const key = `?key=${cfg.apiKey}`;
    const totalEl = root.querySelector<HTMLElement>(".join-total")!;
    const form = root.querySelector<HTMLFormElement>(".join-form")!;
    const msg = root.querySelector<HTMLElement>(".join-msg")!;
    const pick = root.querySelector<HTMLDetailsElement>(".join-pick")!;
    const picked = root.querySelector<HTMLElement>(".join-picked")!;
    const openedAt = Date.now();
    let lastTotal = -1;

    // 그림을 고르면 접고, 고른 그림을 제목줄에 보여 준다.
    pick.addEventListener("change", (e) => {
      const t = e.target as HTMLInputElement;
      if (t.name === "avatar") { clearPhoto(); picked.textContent = t.value; pick.open = false; }
    });

    // 스팸 방어: reCAPTCHA v3 → App Check 토큰. 사이트 키가 없으면 쓰지 않는다.
    let guard: { token: string; until: number } | null = null;
    let recaptchaLoading: Promise<void> | null = null;
    const loadRecaptcha = () => (recaptchaLoading ||= new Promise<void>((ok, fail) => {
      const el = document.createElement("script");
      el.src = `https://www.google.com/recaptcha/api.js?render=${cfg.appCheck.siteKey}`;
      el.onload = () => ok();
      el.onerror = () => fail(new Error("recaptcha"));
      document.head.appendChild(el);
    }));
    async function guardToken(): Promise<string | null> {
      if (!cfg.appCheck.siteKey) return null;
      if (guard && guard.until > Date.now()) return guard.token;
      try {
        await loadRecaptcha();
        const g = (window as any).grecaptcha;
        await new Promise<void>((ok) => g.ready(() => ok()));
        const rc = await g.execute(cfg.appCheck.siteKey, { action: "firestore" });
        const r = await fetch(`https://firebaseappcheck.googleapis.com/v1/projects/${cfg.projectId}/apps/${cfg.appCheck.appId}:exchangeRecaptchaV3Token${key}`, {
          method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ recaptcha_v3_token: rc }),
        });
        if (!r.ok) return null;
        const j = (await r.json()) as { token: string; ttl: string };
        guard = { token: j.token, until: Date.now() + Math.max(60, parseInt(j.ttl, 10) - 60) * 1000 };
        return j.token;
      } catch { return null; }
    }

    const post = async (path: string, body: unknown) => {
      const headers: Record<string, string> = { "content-type": "application/json" };
      const t = await guardToken();
      if (t) headers["X-Firebase-AppCheck"] = t;
      return fetch(`${base}${path}${key}`, { method: "POST", headers, body: JSON.stringify(body) });
    };

    // 내 그림: 이 기기 안에서 96×96으로 줄이고(선택하면 만화 느낌으로), 작은 JPEG 글자열로 만든다.
    const photoInput = root.querySelector<HTMLInputElement>("#join-photo")!;
    const cartoonBox = root.querySelector<HTMLInputElement>("#join-cartoon")!;
    const photoClear = root.querySelector<HTMLButtonElement>(".join-photo-clear")!;
    let photoBitmap: ImageBitmap | null = null;
    let photoData = "";

    function cartoonize(img: ImageData) {
      const { width: w, height: h, data } = img;
      const lum = new Float32Array(w * h);
      for (let i = 0; i < w * h; i++) lum[i] = 0.299 * data[i * 4] + 0.587 * data[i * 4 + 1] + 0.114 * data[i * 4 + 2];
      for (let y = 0; y < h; y++) for (let x = 0; x < w; x++) {
        const i = y * w + x;
        let edge = 0;
        if (x > 0 && y > 0 && x < w - 1 && y < h - 1) {
          const gx = -lum[i - w - 1] - 2 * lum[i - 1] - lum[i + w - 1] + lum[i - w + 1] + 2 * lum[i + 1] + lum[i + w + 1];
          const gy = -lum[i - w - 1] - 2 * lum[i - w] - lum[i - w + 1] + lum[i + w - 1] + 2 * lum[i + w] + lum[i + w + 1];
          edge = Math.hypot(gx, gy);
        }
        for (let c = 0; c < 3; c++) {
          const v = data[i * 4 + c];
          const level = Math.round((v / 255) * 4) * 63.75; // 색을 5단계로 단순화
          data[i * 4 + c] = edge > 140 ? 20 : Math.min(255, level * 1.08);
        }
      }
    }

    function renderPhoto() {
      if (!photoBitmap) { photoData = ""; return; }
      const c = document.createElement("canvas");
      c.width = c.height = 96;
      const ctx = c.getContext("2d")!;
      const side = Math.min(photoBitmap.width, photoBitmap.height);
      ctx.drawImage(photoBitmap, (photoBitmap.width - side) / 2, (photoBitmap.height - side) / 2, side, side, 0, 0, 96, 96);
      if (cartoonBox.checked) { const id = ctx.getImageData(0, 0, 96, 96); cartoonize(id); ctx.putImageData(id, 0, 0); }
      let q = 0.7, url = c.toDataURL("image/jpeg", q);
      while (url.length > 12000 && q > 0.3) { q -= 0.1; url = c.toDataURL("image/jpeg", q); }
      photoData = url.length <= 12000 ? url : "";
      picked.replaceChildren();
      if (photoData) {
        const im = document.createElement("img");
        im.src = photoData; im.alt = ""; im.width = im.height = 36;
        picked.appendChild(im);
      }
    }

    function clearPhoto() {
      photoBitmap = null; photoData = ""; photoInput.value = ""; photoClear.hidden = true;
      picked.textContent = root!.querySelector<HTMLInputElement>("input[name=avatar]:checked")?.value ?? "";
    }

    photoInput.addEventListener("change", async () => {
      const f = photoInput.files?.[0];
      if (!f) { clearPhoto(); return; }
      try {
        photoBitmap = await createImageBitmap(f);
        renderPhoto();
        photoClear.hidden = !photoData;
        if (!photoData) msg.textContent = "그림을 작게 만들지 못했습니다. 다른 그림으로 해 보세요.";
      } catch { clearPhoto(); msg.textContent = "이 파일은 그림으로 읽을 수 없습니다."; }
    });
    cartoonBox.addEventListener("change", renderPhoto);
    photoClear.addEventListener("click", clearPhoto);

    async function loadCounts(): Promise<number | null> {
      try {
        const res = await Promise.all(cfg.fields.map((f) =>
          post(":runAggregationQuery", {
            structuredAggregationQuery: {
              structuredQuery: {
                from: [{ collectionId: "participants" }],
                where: { fieldFilter: { field: { fieldPath: "field" }, op: "EQUAL", value: { stringValue: f } } },
              },
              aggregations: [{ alias: "n", count: {} }],
            },
          }).then((r) => (r.ok ? r.json() : Promise.reject(r.status)))
        ));
        let total = 0;
        cfg.fields.forEach((f, i) => {
          const n = Number(res[i]?.[0]?.result?.aggregateFields?.n?.integerValue ?? 0);
          total += n;
          const b = root!.querySelector(`[data-field="${f}"] .join-count b`);
          if (b) b.textContent = String(n);
        });
        totalEl.textContent = total === 0 ? "첫 참여자를 기다립니다." : `지금까지 ${total}명이 함께하고 있습니다.`;
        return total;
      } catch {
        totalEl.textContent = "참여 현황을 지금은 불러오지 못했습니다.";
        return null;
      }
    }

    async function loadNames() {
      try {
        const r = await post(":runQuery", {
          structuredQuery: { from: [{ collectionId: "participants" }], orderBy: [{ field: { fieldPath: "createdAt" }, direction: "DESCENDING" }], limit: 80 },
        });
        if (!r.ok) return;
        const rows = (await r.json()) as { document?: { fields: Record<string, { stringValue: string }> } }[];
        const byField: Record<string, { text: string; photo: string }[]> = {};
        for (const row of rows) {
          const d = row.document?.fields;
          if (!d || !d.nickname?.stringValue) continue;
          const photo = d.photo?.stringValue ?? "";
          (byField[d.field.stringValue] ||= []).push({
            text: photo ? d.nickname.stringValue : `${d.avatar?.stringValue ?? ""} ${d.nickname.stringValue}`.trim(),
            photo: photo.startsWith("data:image/jpeg;base64,") ? photo : "",
          });
        }
        for (const f of cfg.fields) {
          const ul = root!.querySelector<HTMLElement>(`[data-field="${f}"] .join-names`);
          if (!ul) continue;
          ul.replaceChildren(...(byField[f] || []).map((n) => {
            const li = document.createElement("li");
            if (n.photo) { const im = document.createElement("img"); im.src = n.photo; im.alt = ""; im.width = im.height = 32; li.appendChild(im); }
            li.append(n.text);
            return li;
          }));
        }
      } catch { /* 닉네임 목록은 없어도 신청에는 지장이 없다 */ }
    }

    async function refresh() {
      const total = await loadCounts();
      if (total !== null && total !== lastTotal) { lastTotal = total; await loadNames(); }
    }
    refresh();
    setInterval(() => { if (!document.hidden) refresh(); }, 20000);
    document.addEventListener("visibilitychange", () => { if (!document.hidden) refresh(); });

    const newId = () => Array.from(crypto.getRandomValues(new Uint8Array(10)), (b) => b.toString(16).padStart(2, "0")).join("");
    const str = (v: string) => ({ stringValue: v });

    // 신청 알림 메일(EmailJS). 실패해도 신청 자체에는 영향이 없다.
    function notifyOperator(field: string, nickname: string, consent: boolean, avatar: string, contact: string) {
      const m = cfg.emailjs;
      if (!m.serviceId || !m.templateId || !m.publicKey) return;
      fetch("https://api.emailjs.com/api/v1.0/email/send", {
        method: "POST", headers: { "content-type": "application/json" },
        body: JSON.stringify({
          service_id: m.serviceId, template_id: m.templateId, user_id: m.publicKey,
          template_params: { field: cfg.labels[field] ?? field, nickname: nickname || "(없음)", avatar, consent: consent ? "공개 동의" : "공개 안 함", contact },
        }),
      }).catch(() => {});
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(form);
      const contact = String(fd.get("contact") || "").trim();
      const nickname = String(fd.get("nickname") || "").trim();
      const consent = fd.get("consent") === "on";
      if (fd.get("website")) return; // 봇 거름
      if (contact.length < 5) { msg.textContent = "연락처를 5자 이상 적어 주세요."; return; }
      if (fd.get("privacy") !== "on") { msg.textContent = "연락처 수집·이용에 동의해 주세요."; return; }
      if (consent && !nickname) { msg.textContent = "공개에 동의하셨다면 닉네임을 적어 주세요."; return; }
      if (photoData && !consent) { msg.textContent = "그림을 올리려면 공개 동의에 체크해 주세요."; return; }
      if (Date.now() - openedAt < 3000) { msg.textContent = "잠시 뒤에 다시 눌러 주세요."; return; }
      try { if (localStorage.getItem("join-sent")) { msg.textContent = "이미 신청하셨습니다. 감사합니다."; return; } } catch { /* 저장소를 못 써도 진행 */ }

      const field = String(fd.get("field"));
      const avatar = String(fd.get("avatar"));
      const btn = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
      btn.disabled = true;
      msg.textContent = "보내는 중입니다…";
      const name = (col: string) => `projects/${cfg.projectId}/databases/(default)/documents/${col}/${newId()}`;
      const stamp = [{ fieldPath: "createdAt", setToServerValue: "REQUEST_TIME" }];
      try {
        const r = await post(":commit", {
          writes: [
            { update: { name: name("participants"), fields: { field: str(field), nickname: str(consent ? nickname : ""), avatar: str(avatar), ...(photoData && consent ? { photo: str(photoData) } : {}) } }, currentDocument: { exists: false }, updateTransforms: stamp },
            { update: { name: name("applications"), fields: { field: str(field), nickname: str(nickname), avatar: str(avatar), consent: { booleanValue: consent }, contact: str(contact) } }, currentDocument: { exists: false }, updateTransforms: stamp },
          ],
        });
        if (!r.ok) throw new Error(String(r.status));
        try { localStorage.setItem("join-sent", "1"); } catch { /* 무시 */ }
        notifyOperator(field, nickname, consent, avatar, contact);
        form.reset();
        clearPhoto();
        msg.textContent = "신청되었습니다. 감사합니다!";
        btn.disabled = false;
        lastTotal = -1;
        refresh();
      } catch {
        btn.disabled = false;
        msg.textContent = "지금은 신청을 보내지 못했습니다. fundamentalrights2026@gmail.com 으로 보내 주세요.";
      }
    });
  }
</script>

<style>
  .join { margin: 1.2rem 0; padding: .9rem 1.2rem; border: 1px solid var(--muted); border-radius: 12px; }
  .join-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0 1rem; }
  .join h3 { margin: 0 0 .3rem; }
  .join-total { margin: 0 0 .3rem; font-weight: 700; }
  .join-fields { list-style: none; padding: 0; margin: .3rem 0 .8rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: .3rem 1rem; }
  .join-fields > li { display: flex; flex-wrap: wrap; align-items: baseline; gap: .2rem .7rem; }
  .join-label { font-weight: 700; }
  .join-names { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: .3rem; flex-basis: 100%; }
  .join-names:empty { display: none; }
  .join-names li { padding: .1rem .6rem; border: 1px solid var(--muted); border-radius: 999px; }
  .join-grid { display: grid; grid-template-columns: 1fr 1fr; gap: .4rem 1.4rem; align-items: start; }
  .join-form fieldset { border: 1px solid var(--border); border-radius: 8px; margin: 0; padding: .2rem .8rem .3rem; min-width: 0; }
  .join-choice { display: flex; align-items: center; gap: .5rem; min-height: 48px; }
  .join-choice input { width: 24px; height: 24px; flex: none; }
  .join-pick summary { display: flex; align-items: center; flex-wrap: wrap; gap: .3rem; min-height: 48px; cursor: pointer; }
  .join-picked { font-size: 1.6rem; }
  .join-avatars { display: flex; flex-wrap: wrap; gap: .3rem; padding: .3rem 0 .6rem; }
  .join-avatar { position: relative; display: inline-flex; width: 48px; height: 48px; align-items: center; justify-content: center; border: 2px solid var(--border); border-radius: 12px; font-size: 1.6rem; cursor: pointer; }
  .join-avatar input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
  .join-avatar:has(input:checked) { border-color: var(--accent); background: var(--card); }
  .join-avatar:has(input:focus-visible) { outline: 3px solid var(--accent); outline-offset: 2px; }
  .join-photo { display: grid; gap: .2rem; padding: .2rem 0 .6rem; }
  .join-grid > * { min-width: 0; }
  .join-photo input[type="file"] { min-height: 48px; padding: .6rem 0; font: inherit; width: 100%; box-sizing: border-box; }
  .join-photo-note { margin: 0; color: var(--muted); }
  .join-photo-clear { min-height: 48px; font: inherit; color: var(--fg); background: var(--card); border: 1px solid var(--muted); border-radius: 8px; cursor: pointer; justify-self: start; padding: 0 1rem; }
  .join-picked img { border-radius: 50%; vertical-align: middle; }
  .join-names li img { border-radius: 50%; vertical-align: middle; margin-right: .3rem; }
  .join-row { margin: 0 0 .4rem; display: grid; gap: .1rem; }
  .join-form input[type="text"] { width: 100%; min-height: 48px; padding: 0 .7rem; font: inherit; color: var(--fg); background: var(--bg); border: 1px solid var(--muted); border-radius: 8px; box-sizing: border-box; }
  .join-hp { position: absolute; left: -9999px; }
  .join-send { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem 1rem; }
  .join-btn { min-height: 48px; padding: 0 1.4rem; font: inherit; font-weight: 700; color: var(--brand-fg); background: var(--brand); border: 2px solid var(--brand); border-radius: 8px; cursor: pointer; }
  .join-btn:disabled { opacity: .6; cursor: default; }
  .join-msg { font-weight: 700; }
  .join-note { margin: .6rem 0 0; color: var(--muted); }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  @media (max-width: 700px) { .join-grid { grid-template-columns: 1fr; } }
</style>
