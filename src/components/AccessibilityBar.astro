<div style="display:flex;gap:.3rem">
  <button data-a11y="contrast" aria-label="고대비 켜고 끄기" style="border:1px solid var(--border);border-radius:6px;background:var(--bg);color:var(--fg);cursor:pointer;padding:.2rem .5rem">◐</button>
  <button data-a11y="font-up" aria-label="글자 크게" style="border:1px solid var(--border);border-radius:6px;background:var(--bg);color:var(--fg);cursor:pointer;padding:.2rem .5rem">A+</button>
  <button data-a11y="font-down" aria-label="글자 작게" style="border:1px solid var(--border);border-radius:6px;background:var(--bg);color:var(--fg);cursor:pointer;padding:.2rem .5rem">A−</button>
</div>
