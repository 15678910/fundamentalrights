---
const { lines = [] } = Astro.props;
---
<aside style="border:1px solid var(--border);background:var(--card);border-radius:8px;padding:1rem;margin:1.5rem 0">
  <h2 style="font-size:1.05rem;margin:.2rem 0">🤝 도움이 필요하면</h2>
  <ul style="margin:.5rem 0 0;padding-left:1.2rem;line-height:1.9">
    {lines.map((l: any) => (
      <li><strong>{l.name}</strong> <span style="color:var(--accent)">{l.number}</span>{l.desc ? ` — ${l.desc}` : ""}</li>
    ))}
  </ul>
</aside>
